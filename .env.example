# 디스코드 — 명령어는 전역 등록. 봇을 넣은 모든 서버에서 쓰고, 포인트는 서버마다 따로 쌓인다.
DISCORD_TOKEN=

# DB — SQLite 파일 하나. 비우면 <봇 폴더>/data/kimmansik.db (백업 = 이 파일 복사)
DB_FILE=

# uri 봇 연계 (비우면 연계 꺼짐 → 별명은 이 봇이 직접 끝에 숫자를 붙임)
# uri 레포 link/kimmansik.secret 과 같은 값
LINK_SECRET=
LINK_ID=kimmansik
LINK_VARIABLE=PT
LINK_API_URL=http://127.0.0.1:4200/dashboard/api/link
